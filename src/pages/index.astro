---
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostsNewestFirst } from '../lib/posts';

const posts = await getPostsNewestFirst();
---

<BaseLayout>
  <section class="posts">
    <h2>記事</h2>
    {
      posts.length === 0 ? (
        <p>記事はまだありません。</p>
      ) : (
        <div class="cards">
          {posts.map(({ id, data }) => (
            <PostCard id={id} data={data} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
