---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE_TAGLINE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/date';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout>
  <div class="hero">
    <p class="hero-title">{SITE_TAGLINE.map((phrase) => <span>{phrase}</span>)}</p>
  </div>
  <section class="posts">
    <h2>記事</h2>
    {
      posts.length === 0 ? (
        <p>記事はまだありません。</p>
      ) : (
        <div class="cards">
          {posts.map(({ id, data }) => (
            <article class="card">
              <a href={`/posts/${id}/`}>
                {data.cover ? <Image class="cover" src={data.cover} alt="" /> : <div class="cover" />}
                <div class="card-meta">
                  {data.category && <span class="category">{data.category}</span>}
                  <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
                  {data.pr && <span class="pr-tag">PR</span>}
                </div>
                <h3>{data.title}</h3>
                <p>{data.description}</p>
              </a>
            </article>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
